# PingPulse ortam değişkenleri şablonu.
# .env dosyası olmadan da sistem çalışır: docker-compose.yml içinde
# geliştirme amaçlı varsayılanlar var. Production'da secret'ları MUTLAKA değiştirin.
# Kullanım: bu dosyayı .env olarak kopyalayıp değerleri düzenleyin.

# --- PostgreSQL (auth-service) ---
POSTGRES_USER=pingpulse
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_DB=auth
# auth-service'in bağlantı adresi compose içinde yukarıdaki değerlerden üretilir.
# Şifrede #, @, / gibi karakterler varsa adresi URL-encode ederek doğrudan verin:
# DATABASE_URL=postgresql://pingpulse:p%23ss@postgres:5432/auth

# --- Host portları (sadece geliştirici erişimi; servisler Docker iç ağını kullanır) ---
POSTGRES_HOST_PORT=5433
MONGO_HOST_PORT=27018

# --- Ortak secret'lar (auth + monitoring) ---
JWT_SECRET=dev-only-jwt-secret
JWT_EXPIRES_IN=1h
INTERNAL_TOKEN=dev-only-internal-token

# --- Worker (eşzamanlılık ve kontrol ayarları) ---
CHECK_CONCURRENCY=10
CHECK_INTERVAL_SECONDS=60
CHECK_TIMEOUT_MS=5000
CHECK_MAX_RETRIES=2
WORKER_TICK_MS=1000
# CHECK_CONCURRENCY değerinden küçük olmamalı (PLAN §7: DNS ve thread pool)
UV_THREADPOOL_SIZE=16

# --- Güvenlik ---
# true yapılırsa iç ağ adresleri (localhost, 10.x ...) izlenebilir. Sadece yerel denemeler içindir.
ALLOW_PRIVATE_TARGETS=false
